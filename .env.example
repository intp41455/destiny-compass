# 命理罗盘 Destiny Compass - 环境变量配置
# 复制为 .env 并填入实际值

# ============ MCP-8 LLM 网关（必需，否则 LLM 分析会降级）============
# OpenAI 兼容协议，支持 OpenAI / Azure / DeepSeek / Moonshot / 智谱 GLM / 通义 / 本地 Ollama 等
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.openai.com
LLM_DEFAULT_MODEL=gpt-4o
LLM_TIMEOUT_MS=60000

# ============ 编排层端口（可选，默认 3000）============
# PORT=3000

# ============ MCP 服务端口覆盖（可选，默认值见下）============
# MCP_HOST_BAZI=localhost
# MCP_HOST_LLM=localhost
# MCP_HOST_ZIWEI=localhost   # Phase 2 接入
# MCP_HOST_VEDIC=localhost   # Phase 2 接入
# MCP_HOST_WESTERN=localhost # Phase 2 接入
# MCP_HOST_ARABIC=localhost  # Phase 2 接入
# MCP_HOST_RAG=localhost     # Phase 2 接入
# MCP_HOST_SEARCH=localhost  # Phase 2 接入

# ============ 日志级别（可选，默认 info）============
# LOG_LEVEL=debug
